#!name=Paperclip 签到合集（参数控制版）
#!desc=33个签到项目独立控制，共35条定时任务；模块参数中每项填1启用、0关闭。merge=1时11:30统一汇总。
#!arguments=merge:1,weibotalk:1,tenvideo:1,mihoyo:1,newmixc:1,mishop:1,milottery:1,youpin:1,lhtj_app:1,qqmusic:1,wanda:1,tingtingfm:1,wps:1,camscanner:1,dreame:1,linghu:1,nodeseek:1,pan1:1,agentrouter:1,sgcc:1,cmcc:1,heybox:1,baidunetdisk:1,laifen:1,ppmt:1,tuhu:1,haidilao:1,huisheng:1,miniso:1,longde:1,lhtj:1,wedome:1,bhg:1,linli:1
#!arguments-desc=merge及各项目参数：1=启用，0=关闭。QQ音乐每日任务、定时金币、红包雨共用qqmusic开关。需要将paperclip-runner.js放入Surge可读取的本地脚本目录。

[Script]
签到汇总 = type=cron,cronexp="30 11 * * *",timeout=60,script-path=paperclip-runner.js,argument="url=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/summary/summary.js;enabled={{{merge}}};merge={{{merge}}};flags=weibotalk:{{{weibotalk}}}|tenvideo:{{{tenvideo}}}|mihoyo:{{{mihoyo}}}|newmixc:{{{newmixc}}}|mishop:{{{mishop}}}|milottery:{{{milottery}}}|youpin:{{{youpin}}}|lhtj_app:{{{lhtj_app}}}|qqmusic:{{{qqmusic}}}|wanda:{{{wanda}}}|tingtingfm:{{{tingtingfm}}}|wps:{{{wps}}}|camscanner:{{{camscanner}}}|dreame:{{{dreame}}}|linghu:{{{linghu}}}|nodeseek:{{{nodeseek}}}|pan1:{{{pan1}}}|agentrouter:{{{agentrouter}}}|sgcc:{{{sgcc}}}|cmcc:{{{cmcc}}}|heybox:{{{heybox}}}|baidunetdisk:{{{baidunetdisk}}}|laifen:{{{laifen}}}|ppmt:{{{ppmt}}}|tuhu:{{{tuhu}}}|haidilao:{{{haidilao}}}|huisheng:{{{huisheng}}}|miniso:{{{miniso}}}|longde:{{{longde}}}|lhtj:{{{lhtj}}}|wedome:{{{wedome}}}|bhg:{{{bhg}}}|linli:{{{linli}}}"
