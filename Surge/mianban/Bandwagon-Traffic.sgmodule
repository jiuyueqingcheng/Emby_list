#!name=搬瓦工 VPS 流量
#!desc=在 Surge 面板显示搬瓦工 VPS 剩余流量
#!system=ios
#!category=面板
#!arguments=VEID,APIKEY,TITLE:Bandwagon VPS,INTERVAL:3600

[Panel]
Bandwagon-VPS = script-name=Bandwagon-VPS,update-interval={{{INTERVAL}}}

[Script]
Bandwagon-VPS = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/jiuyueqingcheng/Emby_list/refs/heads/main/Surge/mianban/bwg-traffic.js,script-update-interval=86400,argument=veid={{{VEID}}}&apikey={{{APIKEY}}}&title={{{TITLE}}}